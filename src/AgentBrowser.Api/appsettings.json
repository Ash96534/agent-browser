{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Browser": {
    "Headless": true,
    "Width": 1920,
    "Height": 1080,
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
  },
  "Session": {
    "MaxSessions": 100,
    "IdleTimeoutMinutes": 30
  },
  "Api": {
    "Port": 5000
  }
}
